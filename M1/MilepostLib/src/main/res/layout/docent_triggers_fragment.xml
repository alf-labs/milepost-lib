<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        tools:context=".fragments.audioSegments.AudioSegmentsFragment">

    <TextView
            android:id="@+id/user_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            />

    <TextView
            android:id="@+id/gps_track_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="GPS Track Label"
            android:layout_below="@id/user_title"
            android:layout_alignParentStart="true"
            />

    <TextView
            android:id="@+id/empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No triggers available. Please add triggers first."
            android:layout_below="@id/gps_track_label"
            android:layout_alignParentStart="true"
            />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/play_trigger_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:layout_marginTop="8dp"
            android:layout_below="@id/gps_track_label"
            android:layout_alignParentBottom="true"
            />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/add_trigger_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:contentDescription="Add Trigger"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/colorPrimary"
            app:tint="?attr/colorOnPrimary"
            />

</RelativeLayout>
