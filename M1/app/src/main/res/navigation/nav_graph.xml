<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/nav_graph"
        app:startDestination="@id/nav_about">

    <!-- Notes:
        - All fragment destination ids here should match drawer_menu.xml item ids.
        - The labels automatically become AppBar/Toolbar titles.

        As usual with Android, there's no clearly defined XML schema.
        Doc:
          https://developer.android.com/guide/navigation/use-graph/pass-data
        The XML parser is here:
          https://android.googlesource.com/platform/frameworks/support/+/refs/heads/androidx-appcompat-release/navigation/navigation-runtime/src/main/java/androidx/navigation/NavInflater.kt
        and
          https://android.googlesource.com/platform/frameworks/support/+/refs/heads/androidx-appcompat-release/navigation/navigation-runtime/src/main/java/androidx/navigation/ActivityNavigator.kt#264
     -->

    <fragment
            android:id="@+id/nav_about"
            android:name="com.alflabs.mpgpstrack.activity.AboutFragment"
            android:label="About"
            tools:layout="@layout/about_fragment">
    </fragment>

    <fragment
            android:id="@+id/nav_tracks"
            android:name="com.alflabs.mpgpstrack.activity.TracksFragment"
            android:label="Tracks"
            tools:layout="@layout/tracks_fragment">
    </fragment>

    <fragment
            android:id="@+id/nav_record_track"
            android:name="com.alflabs.mpgpstrack.activity.SensorsFragment"
            android:label="Record Track"
            tools:layout="@layout/sensors_fragment">
        <argument
                android:name="mode"
                app:argType="com.alflabs.mpgpstrack.app.StatusData"
                android:defaultValue="RECORD" />
    </fragment>

    <fragment
            android:id="@+id/nav_play_track"
            android:name="com.alflabs.mpgpstrack.activity.SensorsFragment"
            android:label="Playback Track"
            tools:layout="@layout/sensors_fragment">
        <argument
                android:name="mode"
                app:argType="com.alflabs.mpgpstrack.app.StatusData"
                android:defaultValue="PLAYBACK" />
    </fragment>

    <fragment
            android:id="@+id/nav_sensors"
            android:name="com.alflabs.mpgpstrack.activity.SensorsFragment"
            android:label="Test Sensors"
            tools:layout="@layout/sensors_fragment">
        <argument
                android:name="mode"
                app:argType="com.alflabs.mpgpstrack.app.StatusData"
                android:defaultValue="SENSOR" />
        <action
                android:id="@+id/action_sensors_to_permissions_dlg"
                app:destination="@id/nav_permissions_dlg">
            <argument
                    android:name="showClose"
                    app:argType="boolean"
                    android:defaultValue="true" />
        </action>
    </fragment>

    <fragment
            android:id="@+id/nav_permissions"
            android:name="com.alflabs.mpgpstrack.activity.PermissionsFragment"
            android:label="Permissions"
            tools:layout="@layout/permissions_fragment">
        <argument
                android:name="showClose"
                app:argType="boolean"
                android:defaultValue="false" />
    </fragment>

    <!-- Same as nav_permission but as a dialog -->
    <dialog
            android:id="@+id/nav_permissions_dlg"
            android:name="com.alflabs.mpgpstrack.activity.PermissionsFragment"
            android:label="Permissions"
            tools:layout="@layout/permissions_fragment">
        <argument
                android:name="showClose"
                app:argType="boolean"
                android:defaultValue="true" />
    </dialog>

    <!-- TBD placeholder -->
    <fragment
            android:id="@+id/nav_settings"
            android:name="com.alflabs.mpgpstrack.activity.PlaceholderFragment"
            android:label="Settings"
            tools:layout="@layout/placeholder_fragment">
    </fragment>

</navigation>
