<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/nav_graph"
        app:startDestination="@id/nav_about">

    <!-- Notes:
        - All fragment destination ids here should match drawer_menu.xml item ids.
        - The labels automatically become AppBar/Toolbar titles.
     -->

    <fragment
            android:id="@+id/nav_about"
            android:name="com.alflabs.mpgpstrack.activity.AboutFragment"
            android:label="About"
            tools:layout="@layout/about_fragment">
    </fragment>

    <fragment
            android:id="@+id/nav_sensors"
            android:name="com.alflabs.mpgpstrack.activity.SensorsFragment"
            android:label="Sensors"
            tools:layout="@layout/sensors_fragment">
        <action
                android:id="@+id/action_sensors_to_permissions_dlg"
                app:destination="@id/nav_permissions_dlg" />
    </fragment>

    <fragment
            android:id="@+id/nav_permissions"
            android:name="com.alflabs.mpgpstrack.activity.PermissionsFragment"
            android:label="Permissions"
            tools:layout="@layout/permissions_fragment">
    </fragment>

    <dialog
            android:id="@+id/nav_permissions_dlg"
            android:name="com.alflabs.mpgpstrack.activity.PermissionsFragment"
            android:label="Permissions"
            tools:layout="@layout/permissions_fragment">
    </dialog>

</navigation>
