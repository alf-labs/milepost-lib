<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp"
        android:keepScreenOn="true"
        tools:context=".fragments.tracks.TracksFragment">

    <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1">

        <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                />

        <TextView
                android:id="@+id/summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Summary"
                android:layout_below="@id/label"
                android:layout_alignParentStart="true"
                />

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/locations_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_below="@id/summary"
                android:layout_above="@+id/export_csv_button"
                />

        <Button
                android:id="@+id/export_json_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export JSON"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/export_csv_button"
                android:layout_alignBaseline="@+id/export_csv_button"
                />

        <Button
                android:id="@+id/export_csv_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export CSV"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                />

    </RelativeLayout>

    <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1">

        <TextView
                android:id="@+id/map_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                />

        <com.google.android.gms.maps.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_below="@id/map_label"
                android:layout_above="@+id/placeholder_button"
                />

        <Button
                android:id="@+id/placeholder_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Placeholder"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                />

    </RelativeLayout>

</LinearLayout>
