<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Location Settings">

        <SwitchPreferenceCompat
                app:key="use_imperial_units"
                app:title="Use Imperial Units"
                />

        <com.alflabs.milepost.fragments.ImperialEditTextPreference
                app:key="threshold_distance_meters"
                app:title="Threshold Distance (meters)"
                app:dialogTitle="Set threshold distance in meters"
                />

        <com.alflabs.milepost.fragments.ImperialEditTextPreference
                app:key="threshold_speed_mps"
                app:title="Threshold Speed (m/s)"
                app:dialogTitle="Set threshold speed in meters per second"
                />

        <ListPreference
                app:key="simulate_gps"
                app:title="Simulate GPS"
                app:entries="@array/pref_simulate_gps_entries"
                app:entryValues="@array/pref_simulate_gps_values"
                app:defaultValue="none"
                app:useSimpleSummaryProvider="true"
                />

        <SwitchPreferenceCompat
                app:key="use_lock_task"
                app:title="Use Lock Task Mode"
                />

        <SwitchPreferenceCompat
                app:key="hide_system_bars"
                app:title="Hide System Bars"
                />

    </PreferenceCategory>

</PreferenceScreen>
