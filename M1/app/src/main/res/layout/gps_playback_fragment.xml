<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".fragments.gpsPlayback.GpsPlaybackFragment"
        >

    <!-- Note: remember to sync with land/playback_fragment.xml -->

    <!-- TOP -->

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

        <Button
                android:id="@+id/start_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:text="Playback"
                />

        <Button
                android:id="@+id/stop_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:text="Stop"
                />

            <TextView
                    android:id="@+id/track_label_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    tools:text="track label"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_below="@id/start_button"
                    android:layout_centerHorizontal="true"
                    />

        <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                tools:text="status placeholder"
                android:layout_marginTop="8dp"
                android:layout_below="@id/track_label_text"
                android:layout_centerHorizontal="true"
                />

        <TextView
                android:id="@+id/location_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location unknown"
                android:textColor="@color/gps_value"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_below="@id/status_text"
                android:layout_centerHorizontal="true"
                />

        <TextView
                android:id="@+id/location_acc_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                tools:text="distance accuracy"
                android:textColor="@color/acc_missing"
                android:layout_below="@id/location_text"
                android:layout_centerHorizontal="true"
                />

    </RelativeLayout>

    <!-- CENTER -->

    <com.google.android.gms.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            />

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
        <ImageButton
                android:id="@+id/zoom_out_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:src="@drawable/zoom_out"
                android:contentDescription="Zoom Out"
                android:layout_alignParentStart="true"
                android:backgroundTint="@color/colorAccent"
                />

        <ImageButton
                android:id="@+id/zoom_in_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:src="@drawable/zoom_in"
                android:contentDescription="Zoom In"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/colorAccent"
                />
    </RelativeLayout>

    <!-- BOTTOM -->

    <TextView
            android:id="@+id/mp_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text=""
            tools:text="MP Value"
            android:textStyle="bold"
            android:textColor="@color/gps_value"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:layout_gravity="center_horizontal"
            />

    <TextView
            android:id="@+id/direction_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text=""
            tools:text="direction"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:layout_gravity="center_horizontal"
            />

    <TextView
            android:id="@+id/speed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            tools:text="SPEED"
            android:textColor="@color/gps_value"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:layout_gravity="center_horizontal"
            />

    <com.alflabs.milepost.fragments.LinearTrackView
            android:id="@+id/linear_track_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            />

</LinearLayout>
