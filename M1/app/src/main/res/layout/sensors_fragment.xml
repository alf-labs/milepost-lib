<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".fragments.SensorsFragment"
        >


    <!-- TOP -->

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

        <Button
                android:id="@+id/start_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:text="Start"
                />

        <Button
                android:id="@+id/stop_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:text="Stop"
                />

        <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                tools:text="status placeholder"
                android:layout_marginTop="16dp"
                android:layout_below="@id/start_button"
                android:layout_centerHorizontal="true"
                />

        <TextView
                android:id="@+id/location_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="location unknown"
                android:textColor="@color/gps_value"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_below="@id/status_text"
                android:layout_centerHorizontal="true"
                />

        <TextView
                android:id="@+id/location_acc_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                tools:text="distance accuracy"
                android:textColor="@color/acc_missing"
                android:layout_below="@id/location_text"
                android:layout_centerHorizontal="true"
                />

    </RelativeLayout>

    <!-- CENTER -->

    <com.google.android.gms.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            />

    <!-- BOTTOM -->

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

        <TextView
                android:id="@+id/center_divider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text=" "
                android:lines="1"
                android:background="@color/colorAccent"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                />

        <TextView
                android:id="@+id/speed_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                tools:text="SPEED"
                android:textColor="@color/gps_value"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:layout_toStartOf="@id/center_divider"
                android:layout_alignTop="@id/center_divider"
                />

        <TextView
                android:id="@+id/speed_acc_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                tools:text="accuracy"
                android:textColor="@color/acc_missing"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:layout_toEndOf="@id/center_divider"
                android:layout_alignTop="@id/center_divider"
                />

    </RelativeLayout>

</LinearLayout>
